# Copy to .env and fill in real values.
# `python-dotenv` (optional) auto-loads this file into os.environ when
# any example runs. Without it the examples read these names from
# the developer's shell environment directly.
#
# Required for every example:
NULLRUN_API_KEY=nr_live_replace_me
# Optional — defaults to https://api.nullrun.io for the managed control plane.
NULLRUN_API_URL=https://api.nullrun.io

# Per-framework vendor keys. Each example only reads its own;
# unset lines are harmless. Required by:
#   raw_openai_basic.py, openai_agents_basic.py,
#   langchain_basic.py, langgraph_basic.py,
#   langgraph_manual_wrapper.py, cost_cap_demo.py,
#   llama_index_basic.py, chain_soft_mode.py, on_error_hook.py,
#   crewai_basic.py, autogen_basic.py
OPENAI_API_KEY=***

# Required by anthropic_basic.py
ANTHROPIC_API_KEY=***

# Required by mistral_basic.py
MISTRAL_API_KEY=***

# Required by gemini_basic.py
GEMINI_API_KEY=***

# Required by cohere_basic.py
COHERE_API_KEY=***

# Required by bedrock_basic.py
AWS_ACCESS_KEY_ID=***
AWS_SECRET_ACCESS_KEY=***
AWS_DEFAULT_REGION=us-east-1