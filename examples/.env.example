# ─────────────────────────────────────────────────────────────────────────
# USER SETUP — what you (the developer) actually need.
#
# Promise (SDK 0.18.1+): "set NULLRUN_API_KEY, slap `@protect` on your
# tool-call function, wrap the entry point in `with nullrun.handle():`,
# you're ready". No `init_or_die()`, no `@guarded`, no framework-extras
# boilerplate — the first `@protect` call lazily creates the runtime
# and auto-instruments httpx (covers OpenAI, Anthropic, Mistral, Gemini,
# Cohere, Bedrock via URL-keyed extractors) plus framework hooks when
# the framework package is importable. All other knobs are SDK-derived
# or wire-probe-only (see below).
#
# `python-dotenv` (optional) auto-loads this file into os.environ when
# any example runs. Without it the examples read these names from
# the developer's shell environment directly:
#   pip install python-dotenv
# ─────────────────────────────────────────────────────────────────────────

# Required for every SDK example. Get one at:
#   https://app.nullrun.io/settings/api-keys
NULLRUN_API_KEY=nr_live_replace_me

# ─────────────────────────────────────────────────────────────────────────
# Per-framework vendor keys — set the ones you actually use.
# Each example only reads its own; unset lines are harmless.
# ─────────────────────────────────────────────────────────────────────────

# openai_basic.py / openai_agents_basic.py / langchain_basic.py /
# langgraph_basic.py / langgraph_manual_wrapper.py / cost_cap_demo.py /
# llama_index_basic.py / chain_soft_mode.py / on_error_hook.py /
# crewai_basic.py / autogen_basic.py
OPENAI_API_KEY=***

# anthropic_basic.py
ANTHROPIC_API_KEY=***

# mistral_basic.py
MISTRAL_API_KEY=***

# gemini_basic.py
GEMINI_API_KEY=***

# cohere_basic.py
COHERE_API_KEY=***

# bedrock_basic.py
AWS_ACCESS_KEY_ID=***
AWS_SECRET_ACCESS_KEY=***
AWS_DEFAULT_REGION=us-east-1


# ─────────────────────────────────────────────────────────────────────────
# ⚠ WIRE-PROBE-ONLY (advanced) — DO NOT set these for normal examples.
# ─────────────────────────────────────────────────────────────────────────
# These 4 vars exist ONLY because a handful of `qa/probes/*.py` scripts
# bypass the SDK and talk to NULLRUN directly via httpx — they need to
# know the backend URL, sign request bodies with HMAC, and target the
# correct org/workflow via SQL filters. For ALL examples and demos under
# `examples/`, the SDK derives these from `NULLRUN_API_KEY` at the
# first `@protect` call (lazy init in 0.18.1+):
#
#   * `api_url`      → hardcoded default `https://api.nullrun.io` in the SDK
#                      constructor; override here ONLY if you point at staging.
#   * `organization_id` → set by SDK on first `/auth/verify` — NOT a
#                         public init parameter (see
#                         nullrun/runtime.py: "organization_id is set from
#                         _authenticate; NOT a public init parameter").
#   * `workflow_id`  → set by SDK from `organization_api_keys.workflow_id`
#                      1:1 binding to your key — users do NOT specify it.
#   * `secret_key`   → needed only by SDK when HMAC-signing /track and
#                      /track/batch requests through `Transport._add_hmac_headers`
#                      (no-op if unset).
#
# 99% of users ignore everything below this line.

# Required by qa/probes/ts12f/*.py — points to a non-prod backend.
# Default (if unset): https://api.nullrun.io
# NULLRUN_API_URL=https://api.nullrun.io

# Required by qa/probes/ts12f/*.py — HMAC secret for /track and /track/batch
# wire-signing. Never set this for SDK-only paths; the SDK fetches it via
# /auth/verify when needed.
# NULLRUN_API_SECRET=...

# Used only by read-only SQL verification queries inside probes; the SDK
# itself derives `organization_id` server-side from the key. UUID4 string.
# NULLRUN_ORG_ID=...

# Used only when a probe creates a Workflow-scoped policy and needs to
# verify the policy → key binding explicitly. NOT needed by any SDK example.
# NULLRUN_WORKFLOW_ID=...
