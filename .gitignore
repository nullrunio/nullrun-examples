__pycache__/
*.pyc
*.pyo

# Virtualenvs
.venv/
venv/
examples/.venv/
examples/__pycache__/

# Local secrets — NEVER commit. The .env.example template is the only env file in git.
.env
.env.*
*.backup
!.env.example

# Tooling state
.DS_Store
.idea/
.vscode/

# Claude Code internals — keep repo clean of personal session data
.claude/
.claude-flow/
.worktrees/

# Local SDK wheel builds
.local-sdk-dist/

# Throwaway probe scripts (anything starting with `.tmp_`)
*.tmp_*.py

# Internal QA + probes — kept on disk for the QA team, never published.
# `nullrun-examples` is the public "how do I add NullRun to my stack"
# surface; everything in `internal/` is QA harness material, ad-hoc
# probe/debug scripts, and TC runners that assume specific workflows
# configured on the dashboard. Move new internal material here, not
# back into `examples/` or repo root.
internal/

# Internal QA artefacts (kept on disk, never committed)
explotarory testing/
exploratory_testing/
internal/qa/logs/
internal/qa/**/*.log
SDK_BACKEND_PARITY_MATRIX.md

# Wire-dump JSON — internal debug captures containing actor metadata.
# Pattern is kept broad so a new dump at any path is still ignored.
**/_tc*_wire_dump.json
